# Render / Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Set true only when your Postgres provider requires TLS.
DATABASE_SSL=false

# Optional Supabase Storage for durable videos/photos
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=earnzo-media

# Optional backend API protection
EARNZO_API_KEY=
PUBLIC_BASE_URL=https://earnzo-backend.onrender.com
