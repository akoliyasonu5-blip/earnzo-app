{
  "expo": {
    "name": "Earnzo",
    "slug": "earnzo",
    "scheme": "earnzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/earnzo-icon.png",
    "splash": {
      "image": "./assets/earnzo-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.earnzo.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["CAMERA", "RECORD_AUDIO", "MODIFY_AUDIO_SETTINGS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/earnzo-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Earnzo to use your camera for video calls.",
          "microphonePermission": "Allow Earnzo to use your microphone for voice and video calls."
        }
      ]
    ]
  }
}
